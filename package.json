{
  "name": "instruction-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-offline-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node scripts/check-browser.mjs browser",
    "test:pwa": "node scripts/check-browser.mjs pwa",
    "test:tooling": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "lucide-static": "^1.45.0",
    "opentype.js": "2.0.0",
    "preact": "^10.24.3",
    "svg2pdf.js": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.5.1",
    "@types/opentype.js": "1.3.10",
    "axe-core": "^4.13.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
